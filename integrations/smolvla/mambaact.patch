+@lru_cache(maxsize=1)
+def _load_mamba3_cls():
+    try:
+        from mamba_ssm import Mamba3
+    except ImportError as exc:
+        raise ImportError(
+            "Mamba3 is required for SmolVLA-Mamba. Install the vendored mamba package "
+            "or add it to PYTHONPATH."
+        ) from exc
+    logging.info("Using Mamba3 for the SmolVLA-Mamba action expert")
